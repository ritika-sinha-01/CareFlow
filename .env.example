# -----------------------------------------------------------------------------
# CareFlow environment
# Copy to backend/.env (and optionally frontend/.env) before running locally.
# Never commit real secrets.
# -----------------------------------------------------------------------------

# development | demo | production
APP_ENV=development
NODE_ENV=development

# HTTP
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL — use any hosted/local Postgres 16+, Docker, or `npm run db:local`
# Local: DIRECT_URL can match DATABASE_URL.
# Neon production: DATABASE_URL = pooled runtime URL. DIRECT_URL is required (direct, non-pooled).
# Production does not copy DATABASE_URL into DIRECT_URL.
DATABASE_URL="postgresql://careflow:careflow@127.0.0.1:54329/careflow?schema=public"
DIRECT_URL="postgresql://careflow:careflow@127.0.0.1:54329/careflow?schema=public"

# Auth
# Local only. Production must set a unique JWT_SECRET (32+ chars). Placeholder values are rejected.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# Slot holds (minutes)
SLOT_HOLD_MINUTES=5

# Clinic civil time. Working hours, leave dates, and slot labels use this
# IANA timezone. Appointment timestamps are stored in UTC.
CLINIC_TIMEZONE=Asia/Kolkata
APPOINTMENT_REMINDER_HOURS=24

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_STALE_MS=15000

# -----------------------------------------------------------------------------
# Email — production-friendly abstraction (Resend or SMTP)
# Booking NEVER depends on email succeeding.
# If neither provider is configured, email health is UNAVAILABLE.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM="CareFlow <noreply@example.com>"
RESEND_API_KEY=

# Used when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# AI — optional. Appointment booking must succeed if this is missing/failing.
# -----------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Google Calendar — optional. Booking remains valid if unset or sync fails.
# Scope: https://www.googleapis.com/auth/calendar.events
# Redirect URI must match the Google Cloud OAuth client exactly.
# Production: use the public API origin, not localhost.
# -----------------------------------------------------------------------------
CALENDAR_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# -----------------------------------------------------------------------------
# Demo failure simulation — DISABLED in production. Enabled only when
# DEMO_MODE=true (ENABLE_DEMO_SIMULATION is accepted as an alias) and
# APP_ENV/NODE_ENV are not production. Admin-only routes.
# Seed refuses to create demo users when APP_ENV or NODE_ENV is production.
# -----------------------------------------------------------------------------
DEMO_MODE=true
ENABLE_DEMO_SIMULATION=true

# Frontend (also copy relevant values to frontend/.env)
# Production Vercel builds require VITE_API_URL (API origin) at build time.
# VITE_DEMO_MODE=true shows demo login helpers in development only.
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=CareFlow
VITE_CLINIC_TIMEZONE=Asia/Kolkata
VITE_DEMO_MODE=true

# -----------------------------------------------------------------------------
# Production (Vercel + Neon) — required. Localhost values are rejected.
# NODE_ENV=production
# APP_ENV=production
# JWT_SECRET=<unique secret, 32+ characters, not a placeholder>
# FRONTEND_URL=https://<vercel-frontend>
# CORS_ORIGIN=https://<vercel-frontend>
# DATABASE_URL=<Neon pooled runtime URL>
# DIRECT_URL=<Neon direct URL for prisma migrate deploy>
# DEMO_MODE=false
# ENABLE_DEMO_SIMULATION=false
# GOOGLE_REDIRECT_URI=https://<vercel-api>/api/integrations/google/callback
# Vercel frontend build: VITE_API_URL=https://<vercel-api>
# CRON_SECRET=<used by Vercel Cron for GET /api/internal/worker/tick>
# -----------------------------------------------------------------------------
